        "accentActive": "{palette.primary.active}",
        "accentSubtle": "{palette.primary.muted}",
        "accentText": "{palette.primary.light}",
        "onAccent": "{palette.primary.on}",
        "success": "{palette.success.light}",
        "successSubtle": "{palette.success.muted}",
        "warn": "{palette.warn.light}",
        "warnSubtle": "{palette.warn.muted}",
        "danger": "{palette.danger.default}",
        "dangerHover": "{palette.danger.hover}",
        "dangerSubtle": "{palette.danger.muted}",
        "dangerText": "{palette.danger.light}",
        "onDanger": "{palette.white}",
        "focusRing": "{palette.primary.light}"
      },
