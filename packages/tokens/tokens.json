      "500": "#6B7280",
      "600": "#4B5563",
      "700": "#374151",
      "800": "#1F2937",
      "900": "#111827"
    },
    "success": { "default": "#16A34A", "light": "#4ADE80", "subtle": "#DCFCE7", "muted": "#14532D" },
    "warn": { "default": "#D97706", "light": "#FBBF24", "subtle": "#FEF3C7", "muted": "#78350F" },
    "danger": { "default": "#DC2626", "hover": "#B91C1C", "light": "#F87171", "subtle": "#FEE2E2", "muted": "#7F1D1D" },
    "white": "#FFFFFF",
    "black": "#000000"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "full": "9999px"
  },
  "font": {
    "family": {
      "sans": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "size": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600"
    },
    "lineHeight": {
      "tight": "1.25",
      "normal": "1.5"
    }
  },
  "size": {
    "control": { "sm": "32px", "md": "40px", "lg": "48px" },
    "icon": { "sm": "16px", "md": "20px" }
  },
  "border": {
    "width": { "thin": "1px", "thick": "2px" }
  },
  "motion": {
    "duration": { "fast": "150ms", "base": "250ms" },
    "easing": { "out": "cubic-bezier(0, 0, 0.2, 1)" }
