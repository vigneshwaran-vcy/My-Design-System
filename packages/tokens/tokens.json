        "border": "{palette.gray.200}",
        "borderStrong": "{palette.gray.300}",
        "text": "{palette.gray.900}",
        "textMuted": "{palette.gray.600}",
        "textDisabled": "{palette.gray.400}",
        "neutralHover": "{palette.gray.100}",
