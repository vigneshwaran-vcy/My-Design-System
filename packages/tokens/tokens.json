{
  "palette": {
    "primary": {
      "default": "#4F46E5",
      "hover": "#4338CA",
      "active": "#3730A3",
      "light": "#818CF8",
      "subtle": "#EEF2FF",
      "muted": "#312E81",
      "on": "#FFFFFF"
    },
    "gray": {
      "50": "#F9FAFB",
      "100": "#F3F4F6",
