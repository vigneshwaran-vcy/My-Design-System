        "accentHover": "{palette.primary.hover}",
        "accentActive": "{palette.primary.active}",
        "accentSubtle": "{palette.primary.subtle}",
        "accentText": "{palette.primary.default}",
        "onAccent": "{palette.primary.on}",
        "success": "{palette.success.default}",
        "successSubtle": "{palette.success.subtle}",
        "warn": "{palette.warn.default}",
        "warnSubtle": "{palette.warn.subtle}",
