{
  "name": "@my-ds/tokens",
  "version": "0.1.0",
  "description": "Design tokens in three tiers (primitive, semantic, component) compiled to CSS variables and TS exports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "files": ["dist", "tokens.json", "components"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --check",
    "typecheck": "node scripts/build.mjs --check"
  }
}
