{
  "name": "@my-ds/ui",
  "version": "0.1.0",
  "description": "React components for My Design System",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs"
  },
  "peerDependencies": {
    "@my-ds/tokens": "workspace:^",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@iconify-json/solar": "1.2.2",
    "@my-ds/tokens": "workspace:*",
    "@storybook/react": "8.6.19",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigneshwaran-vcy/My-Design-System.git",
    "directory": "packages/ui"
  },
  "license": "UNLICENSED",
  "author": "Vigneshwaran",
  "homepage": "https://vigneshwaran-vcy.github.io/My-Design-System/",
  "bugs": {
    "url": "https://github.com/vigneshwaran-vcy/My-Design-System/issues"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
