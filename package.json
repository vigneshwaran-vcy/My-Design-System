{
  "name": "my-design-system",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:tokens": "pnpm --filter @my-ds/tokens build",
    "build": "pnpm -r build",
    "dev": "pnpm build:tokens && pnpm --filter playground dev",
    "storybook": "pnpm build:tokens && pnpm --filter docs storybook",
    "build-storybook": "pnpm build:tokens && pnpm --filter docs build-storybook",
    "test": "pnpm build:tokens && pnpm -r test",
    "typecheck": "pnpm build:tokens && pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
